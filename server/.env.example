# Server Configuration
PORT=5000

# Vector Database Selection: 'mongo' (default MongoDB Atlas $vectorSearch) or 'pinecone'
VECTOR_DB=mongo

# MongoDB Atlas Database URI (Required for document metadata, and vector storage in 'mongo' mode)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/rag_database?retryWrites=true&w=majority

# Cohere Embeddings API Key (1024-dimension embed-english-v3.0)
COHERE_API_KEY=your_cohere_api_key

# Groq Cloud LLM API Key & Model
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b

# Pinecone Vector Database Configuration (Required if VECTOR_DB=pinecone)
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX_NAME=rag-index

# Optional Pinecone Index Settings (used during setup or custom configurations)
# PINECONE_NAMESPACE=
# PINECONE_INDEX_HOST=
# PINECONE_CLOUD=aws
# PINECONE_REGION=us-east-1
